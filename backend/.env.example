DEBUG=True
SECRET_KEY=your-django-secret-key-here
APP_NAME=ZELORA
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
FRONTEND_URL=http://localhost:5173

# Email SMTP Settings (Google Gmail App Password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_character_app_password
DEFAULT_FROM_EMAIL=your_email@gmail.com

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# AI Assistant (Groq LLM)
GROQ_API_KEY=your_groq_api_key_here

# Redis In-Memory Cache & Session Broker
REDIS_URL=redis://127.0.0.1:6379/1
USE_REDIS_SESSIONS=False

# PostgreSQL Relational Database (Docker / Production)
USE_POSTGRES=False
POSTGRES_DB=zelora_db
POSTGRES_USER=zelora_admin
POSTGRES_PASSWORD=your_secure_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

